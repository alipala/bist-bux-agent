<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alipala.finagent.sabah</string>

  <!-- ABD/Asya gecesi kapandi, Avrupa acilmadi, kripto 7/24.
       Kripto GUNLUK BARI 00:00 UTC'de kapaniyor: 22:15 kosusunda o
       gunun bari HENUZ YOK (olculdu 2026-08-19). Bu kosu onu yakalar.

       KAYNAK LISTESI VE SURE BUTCESI BURADA DEGIL:
       config/settings.yaml -> ritim.kipler.sabah
       Plist yalnizca SAATIN tek dogruluk kaynagi; bekci
       (bot/watchdog.py) bu dosyayi okuyor. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/alipala/github/bist-bux-agent/scripts/run_kosu.sh</string>
    <string>sabah</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/alipala/github/bist-bux-agent</string>

  <!-- Hafta ici 08:00 (Europe/Amsterdam = makinenin yerel saati).
       launchd, cron'dan farkli olarak makine uykudayken kacirilan isi
       UYANINCA calistirir; cron sessizce atlar. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer>
          <key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer>
          <key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer>
          <key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer>
          <key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer>
          <key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <!-- Zamanlanmis is: RunAtLoad YOK (yuklendigi an calismasin) ve
       KeepAlive YOK (bitince yeniden baslamasin). -->
  <key>RunAtLoad</key>
  <false/>

  <!-- ExitTimeOut BIR CALISMA SURESI SINIRI DEGILDIR: launchd isi
       DURDURURKEN (unload, sistem kapanmasi) SIGTERM ile SIGKILL
       arasinda tanidigi suredir ve uzun suren zamanlanmis bir isi
       OLDURMEZ. Gercek sure siniri ayarda (kabuk_butce_sn) ve
       run_kosu.sh onu uyguluyor. Buradaki kucuk deger yalnizca
       sistem kapanmasini geciktirmemek icin. -->
  <key>ExitTimeOut</key>
  <integer>60</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>tr_TR.UTF-8</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/alipala/github/bist-bux-agent/data/pulse.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alipala/github/bist-bux-agent/data/pulse.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
