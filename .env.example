# ==========================================================
#  BIST/BUX Analiz Agent — ortam degiskenleri
#  Bu dosyayi ".env" olarak kopyala ve doldur. .env ASLA commit edilmez.
# ==========================================================

# --- Claude (analiz katmani) ---
ANTHROPIC_API_KEY=

# --- Telegram bildirimleri ---
# 1) @BotFather ile bot olustur -> token
# 2) Bota bir mesaj at, sonra:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  -> chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Jev (TypeSafe) — haber zenginlestirme (`haberjev` kaynagi) ---
# console.typesafe.ai/keys. Bos ise kaynak "atlandi" doner; baska hicbir
# sey etkilenmez. Yalnizca kamuya acik haber metni gonderilir.
TYPESAFE_API_KEY=

# --- Opsiyonel ---
# Tarayici profilinin saklanacagi dizin (varsayilan: ./.browser_profile)
BROWSER_PROFILE_DIR=

# SQLite yolu (varsayilan: ./data/finagent.db)
DB_PATH=

# DIKKAT: Broker sifreleri burada TUTULMAZ.
# Midas/BUX girisleri "python run.py login" ile bir kez elle yapilir,
# oturum cerezleri tarayici profilinde saklanir.

# --- Piyasa verisi (opsiyonel) ---
# Alpha Vantage: FX kuru, Amsterdam kotasyonlari, hisse sayisi, kripto haberi.
# Ucretsiz anahtar 20 saniyede alinir, kart istemez:
#   https://www.alphavantage.co/support/#api-key
# UCRETSIZ KATMAN: gunde 25 istek + saniyede 1 istek. Bu yuzden MCP sunucusu
# olarak DEGIL, zamanlanmis collector olarak kullaniliyor (~10 istek/gun).
ALPHA_VANTAGE_API_KEY=

# Tiingo: yalnizca FX YEDEGI, varsayilan kapali (settings.yaml).
# Kotasi genis (1000/gun) ama Euronext kapsami yok ve haber API'si
# ucretsiz katmanda kapali — olculdu, bkz. collectors/tiingo.py
TIINGO_API_KEY=

# --- Dis izleyici (opsiyonel, "dead man's switch") ---
# Makine TAMAMEN kapaliyken haber alabilmenin tek yolu. Bot her dongude bu
# adrese sinyal gonderir; sinyal KESILIRSE o servis sana uyari yollar.
# Yerel hicbir surec "ben kapaliyim" diyemez — o yuzden disarisi gerekiyor.
# healthchecks.io ucretsiz katmani yeterli.
HEARTBEAT_URL=

# IBKR sunucu alarmlarinin e-postasi (/alarm). Yoksa alarm KURULMAZ.
IBKR_ALARM_EPOSTA=
